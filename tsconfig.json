{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "cli/src",
    "outDir": "cli/dist",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": true
  },
  "include": ["cli/src/**/*.ts", "cli/src/**/*.mts"]
}

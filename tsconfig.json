{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "terminal/src",
    "outDir": "terminal/dist",
    "resolveJsonModule": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true
  },
  "include": ["terminal/src/**/*.ts", "terminal/src/**/*.mts"],
  "exclude": ["terminal/src/**/__tests__/**"]
}

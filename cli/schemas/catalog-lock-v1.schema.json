{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:kitia:inventory:1",
  "title": "Kitia source installation inventory version 1",
  "description": "Configured external source ownership and file fingerprints. Local catalog resources, bundles, and MCPs are not part of this format.",
  "type": "object",
  "required": ["lock_version", "catalog", "sources"],
  "additionalProperties": false,
  "properties": {
    "lock_version": { "const": 1 },
    "catalog": { "enum": ["grasdouble/Kitia"] },
    "sources": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "skills": { "$ref": "#/definitions/sourceCollection" },
          "agents": { "$ref": "#/definitions/sourceCollection" },
          "instructions": { "$ref": "#/definitions/sourceCollection" }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sourceCollection": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["source_repository", "source_path", "files"],
        "properties": {
          "source_repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "source_path": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
          "apply_to": { "type": "array", "items": { "type": "string" } },
          "license_status": { "type": "string" },
          "files": { "$ref": "#/definitions/files" }
        },
        "additionalProperties": false
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "executable"],
        "properties": {
          "sha256": { "$ref": "#/definitions/sha256" },
          "executable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}

{
  "name": "kitia-workspace",
  "private": true,
  "scripts": {
    "format": "oxfmt \"{scripts,docs/test,terminal/{src,test,scripts},web/{src,test,scripts}}/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "format:check": "pnpm run format --check",
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @grasdouble/kitia-web run dev",
    "prepare": "husky",
    "test": "pnpm run docs:test && pnpm -r run test",
    "docs:test": "node --test docs/test/documentation.test.js",
    "changeset:format": "node scripts/check-changeset-format.mjs",
    "changeset:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release": "changeset publish",
    "terminal:build": "pnpm --filter @grasdouble/kitia run build",
    "terminal:dev": "pnpm run terminal:build && node terminal/dist/kitia.js",
    "terminal:prepack": "pnpm --filter @grasdouble/kitia run prepack",
    "terminal:postpack": "pnpm --filter @grasdouble/kitia run postpack",
    "terminal:typecheck:tests": "pnpm --filter @grasdouble/kitia run typecheck:tests",
    "terminal:test": "pnpm --filter @grasdouble/kitia run test",
    "terminal:test:contract": "pnpm --filter @grasdouble/kitia run test:contract",
    "terminal:test:core:source": "pnpm --filter @grasdouble/kitia run test:core:source",
    "terminal:test:source": "pnpm --filter @grasdouble/kitia run test:source",
    "terminal:test:tui:source": "pnpm --filter @grasdouble/kitia run test:tui:source",
    "terminal:test:package-smoke": "pnpm --filter @grasdouble/kitia run test:package-smoke",
    "terminal:validate": "pnpm --filter @grasdouble/kitia run validate",
    "web:build": "pnpm --filter @grasdouble/kitia-web run build",
    "web:dev": "pnpm --filter @grasdouble/kitia-web run dev",
    "web:preview": "pnpm --filter @grasdouble/kitia-web run preview",
    "web:test": "pnpm --filter @grasdouble/kitia-web run test",
    "web:test:termless": "pnpm --filter @grasdouble/kitia-web run test:termless",
    "web:screenshots:update:termless": "pnpm --filter @grasdouble/kitia-web run screenshots:update:termless"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "oxfmt": "0.79.0"
  },
  "engines": {
    "node": ">=26"
  }
}

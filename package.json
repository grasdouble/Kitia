{
  "name": "kiti",
  "version": "1.0.0",
  "private": true,
  "description": "Kiti — Your AI toolkit, in good hands.",
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/Kiti.git"
  },
  "homepage": "https://github.com/grasdouble/Kiti#readme",
  "bugs": {
    "url": "https://github.com/grasdouble/Kiti/issues"
  },
  "keywords": ["ai", "agents", "skills", "catalog"],
  "bin": {
    "kiti": "./bin/kiti.js"
  },
  "files": [
    "catalogs/",
    "dist/",
    "bin/kiti.js",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/cli-contract.md",
    "docs/bundles.md",
    "docs/inventory-migrations.md",
    "migrations/",
    "schemas/",
    "scripts/prepare-catalog.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean-build.js && tsc -p tsconfig.json",
    "prepare": "npm run build && node scripts/prepare-catalog.js && husky",
    "postpack": "node scripts/prepare-catalog.js --clean",
    "test": "npm run build && node --test tests/catalog.test.js tests/site.test.js tests/documentation.test.js tests/technical.test.js tests/contract.test.js tests/bundles.test.js tests/source-catalogs.test.js tests/migrations.test.js",
    "test:contract": "npm run build && node --test tests/contract.test.js",
    "test:browser": "playwright test",
    "test:package": "node scripts/package-smoke.js",
    "validate": "npm run build && node bin/kiti.js validate",
    "catalog:build": "npm run build && node scripts/generate-catalog.js",
    "catalog:check": "npm run build && node scripts/generate-catalog.js --check",
    "catalog:sources-build": "npm run build && node scripts/build-source-catalogs.js",
    "site:build": "npm run build && node scripts/build-site.js",
    "site:dev": "npm run build && node scripts/serve-site.js"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "ajv": "8.20.0",
    "husky": "^9.1.7",
    "typescript": "5.9.3"
  }
}

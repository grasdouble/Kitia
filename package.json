{
  "name": "@grasdouble/kitia",
  "version": "2.0.0",
  "description": "Kitia — Your AI toolkit, in good hands.",
  "keywords": [
    "agents",
    "ai",
    "catalog",
    "skills"
  ],
  "homepage": "https://github.com/grasdouble/Kitia#readme",
  "bugs": {
    "url": "https://github.com/grasdouble/Kitia/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grasdouble/Kitia.git"
  },
  "bin": {
    "kitia": "terminal/dist/kitia.js"
  },
  "files": [
    "terminal/dist/cli/",
    "terminal/dist/core/",
    "terminal/dist/tui/",
    "terminal/dist/table-layout.js",
    "terminal/dist/kitia.js",
    "terminal/dist/migrations/**/*.js",
    "terminal/schemas/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/cli-contract.md",
    "docs/inventory-migrations.md",
    "docs/resource-audit.md",
    "docs/resource-collections.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "format": "oxfmt \"scripts/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"docs/test/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"terminal/src/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"terminal/test/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"terminal/scripts/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/src/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/test/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/scripts/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "format:check": "oxfmt --check \"scripts/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"docs/test/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"terminal/src/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"terminal/test/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"terminal/scripts/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/src/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/test/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/scripts/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" \"web/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "build": "pnpm run cli:build && pnpm run web:build",
    "prepare": "pnpm run cli:build && husky",
    "test": "pnpm run docs:test && pnpm run typecheck:tests && pnpm run cli:test && pnpm run web:test:components",
    "cli:build": "rimraf dist terminal/dist && tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.type-tests.json",
    "cli:test": "pnpm run cli:test:contract && node --test \"terminal/test/*.test.js\" && pnpm run cli:test:source && pnpm run tui:test:source",
    "tui:test:source": "tsx --test \"terminal/src/tui/**/__tests__/*.test.js\"",
    "cli:test:contract": "pnpm run cli:build && node --test terminal/test/contract/cli-contract.test.js",
    "core:test:source": "tsx --test \"terminal/src/core/**/__tests__/*.test.js\"",
    "cli:test:source": "tsx --test \"terminal/src/cli/**/__tests__/*.test.js\" && pnpm run core:test:source",
    "cli:test:package-smoke": "pnpm run cli:build && node terminal/scripts/package-smoke.js",
    "cli:validate": "pnpm run cli:build && node terminal/dist/kitia.js validate",
    "changeset": "changeset",
    "changeset:format": "node scripts/check-changeset-format.mjs",
    "changeset:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release": "changeset publish",
    "docs:test": "node --test docs/test/documentation.test.js",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:test:components": "node --conditions=development --test web/src/analytics.test.mjs web/src/HomePage.test.mjs web/src/sectionScrolling.test.mjs web/src/components/core/Header.test.mjs web/src/components/sections/Changelog.test.mjs web/src/components/demo/browserTerminal.test.mjs web/src/components/demo/tuiDemoSession.test.mjs web/test/browser-ink-dev.test.mjs web/test/website-screenshots.test.mjs",
    "web:test:termless": "node web/scripts/screenshots-generator/termless-preflight.js && pnpm run cli:build && node --test web/test/termless-dashboard.test.mjs",
    "web:screenshots:update:termless": "node web/scripts/screenshots-generator/termless-preflight.js && pnpm run cli:build && node web/scripts/screenshots-generator/update-site-screenshots-termless.js"
  },
  "dependencies": {
    "ink": "8.0.0",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spdx-expression-parse": "^4.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@resvg/resvg-js": "2.6.2",
    "@rollup/plugin-inject": "^5.0.5",
    "@tanstack/react-router": "^1.170.46",
    "@termless/core": "0.10.2",
    "@termless/xtermjs": "0.10.2",
    "@types/node": "26.6.6",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "8.20.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "oxfmt": "0.79.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "readable-stream": "^4.8.0",
    "rimraf": "^6.1.4",
    "sharp": "^0.35.5",
    "string_decoder": "^1.3.0",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=26"
  }
}

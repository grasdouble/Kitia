{
  "name": "@grasdouble/kitia",
  "version": "1.1.1",
  "description": "Kitia — Your AI toolkit, in good hands.",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grasdouble/Kitia.git"
  },
  "homepage": "https://github.com/grasdouble/Kitia#readme",
  "bugs": {
    "url": "https://github.com/grasdouble/Kitia/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "skills",
    "catalog"
  ],
  "bin": {
    "kitia": "cli/bin/kitia.js"
  },
  "files": [
    "cli/dist/cli/",
    "cli/dist/catalog/",
    "cli/dist/dashboard/",
    "cli/bin/kitia.js",
    "cli/migrations/",
    "cli/schemas/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/cli-contract.md",
    "docs/inventory-migrations.md",
    "docs/resource-audit.md",
    "docs/resource-collections.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run cli:build && pnpm run web:build",
    "prepare": "pnpm run cli:build && husky",
    "test": "pnpm run docs:test && pnpm run typecheck:strict && pnpm run cli:test && pnpm run web:test:components",
    "cli:build": "rimraf dist cli/dist && tsc -p tsconfig.json",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "cli:test": "pnpm run cli:build && node --test cli/test/source-catalogs.test.js cli/test/source-highlighting.test.js cli/test/dashboard-filters.test.js cli/test/source-history.test.js cli/test/version-check.test.js cli/test/catalog-freshness.test.js cli/test/action-retry.test.js cli/test/collections.test.js cli/test/migrations.test.js cli/test/audit.test.js cli/test/catalog-render.test.js cli/test/license.test.js",
    "cli:test:contract": "pnpm run cli:build && node --test cli/test/source-catalogs.test.js cli/test/source-history.test.js",
    "cli:test:package-smoke": "pnpm run cli:build && node cli/scripts/package-smoke.js",
    "cli:validate": "pnpm run cli:build && node cli/bin/kitia.js validate",
    "changeset": "changeset",
    "changeset:format": "node scripts/check-changeset-format.mjs",
    "changeset:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release": "changeset publish",
    "docs:test": "node --test docs/test/documentation.test.js",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:test:components": "node --test web/src/components/core/Header.test.mjs web/src/components/sections/Changelog.test.mjs",
    "web:test:termless": "node web/scripts/screenshots-generator/termless-preflight.js && pnpm run cli:build && node --test web/test/termless-dashboard.test.mjs",
    "web:screenshots:update:termless": "node web/scripts/screenshots-generator/termless-preflight.js && pnpm run cli:build && node web/scripts/screenshots-generator/update-site-screenshots-termless.js"
  },
  "dependencies": {
    "ink": "8.0.0",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spdx-expression-parse": "^4.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@resvg/resvg-js": "2.6.2",
    "@termless/core": "0.10.2",
    "@termless/xtermjs": "0.10.2",
    "@types/node": "22.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "ajv": "8.20.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "rimraf": "^6.1.4",
    "typescript": "5.9.3",
    "vite": "^6.4.1"
  }
}

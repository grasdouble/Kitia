{
  "name": "kitia",
  "version": "1.0.0",
  "private": true,
  "description": "Kitia — Your AI toolkit, in good hands.",
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/Kitia.git"
  },
  "homepage": "https://github.com/grasdouble/Kitia#readme",
  "bugs": {
    "url": "https://github.com/grasdouble/Kitia/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "skills",
    "catalog"
  ],
  "bin": {
    "kitia": "./bin/kitia.js"
  },
  "files": [
    "dist/",
    "bin/kitia.js",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/cli-contract.md",
    "docs/inventory-migrations.md",
    "migrations/",
    "schemas/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "prepare": "npm run build && husky",
    "test": "npm run build && node --test tests/documentation.test.js tests/source-catalogs.test.js tests/migrations.test.js",
    "test:contract": "npm run build && node --test tests/source-catalogs.test.js",
    "test:termless": "node scripts/screenshots-generator/termless-preflight.js && npm run build && node --test tests/termless-dashboard.test.mjs",
    "test:package-smoke": "node scripts/tests/package-smoke.js",
    "update:screenshots:termless": "node scripts/screenshots-generator/termless-preflight.js && npm run build && node scripts/screenshots-generator/update-site-screenshots-termless.js",
    "validate": "npm run build && node bin/kitia.js validate"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@termless/core": "0.10.2",
    "@termless/xtermjs": "0.10.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "ajv": "8.20.0",
    "husky": "^9.1.7",
    "rimraf": "^6.1.4",
    "typescript": "5.9.3"
  }
}


{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortImports": {
    "sortSideEffects": false,
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "dist",
    "build",
    "coverage",
    ".next",
    ".output",
    "*.min.js",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock"
  ]
}

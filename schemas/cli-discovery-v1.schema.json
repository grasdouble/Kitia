{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:kitia:cli-discovery:1",
  "title": "Kitia CLI legacy discovery array contract",
  "description": "The array has no embedded version. Aggregate list/search include catalog on each item; community entries retain their upstream-reference fields.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "kind", "description"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "kind": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "catalog": { "type": "string", "minLength": 1 },
      "group": { "type": "string", "minLength": 1 },
      "status": { "enum": ["experimental", "stable", "deprecated"] },
      "source": false,
      "applyTo": false
    }
  }
}
